# =============================================================================
# SNOWFLAKE CREDENTIALS TEMPLATE
# =============================================================================
# 1. Copy this file and rename the copy to  secrets.toml  (same folder).
# 2. Fill in your real Snowflake details below.
# 3. NEVER share or commit secrets.toml — it holds your credentials.
#
# Streamlit reads .streamlit/secrets.toml automatically, and
# st.connection("snowflake") uses the [connections.snowflake] section.
# =============================================================================

[connections.snowflake]
account = "your_account_identifier"   # e.g. "abcd-xy12345" (from your Snowflake URL)
user = "your_username"
role = "your_role"                    # e.g. "ANALYST"
warehouse = "your_warehouse"          # e.g. "COMPUTE_WH"
database = "your_database"            # e.g. "ANALYTICS"
schema = "your_schema"                # e.g. "PUBLIC"

# --- Authentication: pick ONE of the three below -----------------------------

# (a) Password.
# password = "your_password"

# (b) Key-pair, key on disk — how local development is set up. The .p8 file is
#     gitignored and never ships with the repo, so this only works on a machine
#     that has the key.
private_key_file = ".streamlit/rsa_key.p8"
private_key_file_pwd = "your_key_passphrase"   # omit if the key is unencrypted

# (c) Key-pair, key inline — required on Streamlit Community Cloud, which has
#     no filesystem to hold the .p8. The same key goes in as base64 of the PEM,
#     on a single line; keep private_key_file_pwd if the key is encrypted, and
#     DROP private_key_file, which otherwise takes precedence.
#
#     Run  python tools/make_cloud_secrets.py  to generate this whole block
#     from your local secrets, then paste the result into the Community Cloud
#     app's  Manage app -> Settings -> Secrets  box.
#
# private_key_base64 = "LS0tLS1CRUdJTiBFTkNSWVBURUQg...one long line..."
