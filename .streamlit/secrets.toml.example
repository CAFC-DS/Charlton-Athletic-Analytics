# =============================================================================
# SNOWFLAKE CREDENTIALS TEMPLATE
# =============================================================================
# 1. Copy this file and rename the copy to  secrets.toml  (same folder).
# 2. Fill in your real Snowflake details below.
# 3. NEVER share or commit secrets.toml — it holds your password.
#
# Streamlit reads .streamlit/secrets.toml automatically, and
# st.connection("snowflake") uses the [connections.snowflake] section.
# =============================================================================

[connections.snowflake]
account = "your_account_identifier"   # e.g. "abcd-xy12345" (from your Snowflake URL)
user = "your_username"
password = "your_password"            # or configure key-pair / SSO instead
role = "your_role"                    # e.g. "ANALYST"
warehouse = "your_warehouse"          # e.g. "COMPUTE_WH"
database = "your_database"            # e.g. "ANALYTICS"
schema = "your_schema"                # e.g. "PUBLIC"
